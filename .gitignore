*.egg-info/
*.egg
dist/
build/

# Virtual environment
.venv/
venv/
env/

# Data (SQLite database)
data/
*.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
