# NullVector v2.0 Configuration

# ── Discord ──────────────────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# ── Pollinations API ─────────────────────────────────────
POLLINATIONS_KEY=
POLLINATIONS_BASE_URL=https://gen.pollinations.ai
POLLINATIONS_MEDIA_URL=https://media.pollinations.ai

# ── Admin IDs (comma-separated) ──────────────────────────
ADMIN_IDS=

# ── Bot behaviour ────────────────────────────────────────
BOT_PREFIX=!

# ── Default models (v2.0: cost-conscious routing) ───────
# Text: openai-fast (ultra-cheap), openai (standard), deepseek (reasoning)
DEFAULT_TEXT_MODEL=openai-fast
# Image: sana (dirt cheap), flux (quality), gptimage (pro)
DEFAULT_IMAGE_MODEL=sana

# ── Memory settings ──────────────────────────────────────
STM_MESSAGES=8
LTM_SUMMARY_THRESHOLD=6
MAX_MEMORY=50

# ── Rate limiting ────────────────────────────────────────
# Max requests per user per hour
RATE_LIMIT_HOURLY=30
# Max requests per user per day
RATE_LIMIT_DAILY=100
